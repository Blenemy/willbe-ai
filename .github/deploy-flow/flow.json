{
  "$schema": "./flow.schema.json",
  "flows": {
    "prepare": [
      {
        "name": "pre-deployment",
        "script": "./scripts/pre-deploy.sh",
        "description": "Pre-deployment tasks like stopping services and backup"
      }
    ],
    "deploy": [
      {
        "name": "nginx",
        "script": "./scripts/nginx.sh",
        "description": "Run nginx"
      },
      {
        "name": "post-deployment",
        "script": "./scripts/post-deploy.sh",
        "description": "Post-deployment tasks like starting services"
      }
    ]
  }
}
