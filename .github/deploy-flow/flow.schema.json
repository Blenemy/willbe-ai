{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Path to the JSON Schema file"
    },
    "flows": {
      "type": "object",
      "required": [
        "prepare",
        "deploy"
      ],
      "properties": {
        "prepare": {
          "type": "array",
          "description": "Preparation phase flows that run before deployment",
          "items": {
            "$ref": "#/definitions/flow"
          },
          "minItems": 1
        },
        "deploy": {
          "type": "array",
          "description": "Main deployment phase flows",
          "items": {
            "$ref": "#/definitions/flow"
          },
          "minItems": 1
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "flows"
  ],
  "definitions": {
    "flow": {
      "type": "object",
      "required": [
        "name",
        "script",
        "description"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "Unique identifier for the flow"
        },
        "script": {
          "type": "string",
          "description": "Path to the script file",
          "pattern": "^\\./.*\\.sh$"
        },
        "description": {
          "type": "string",
          "description": "Description of what the flow does"
        },
        "continueOnError": {
          "type": "boolean",
          "description": "Whether to continue execution if this flow fails",
          "default": false
        },
        "timeout": {
          "type": "number",
          "description": "Timeout in milliseconds for this flow execution",
          "minimum": 0
        }
      },
      "additionalProperties": false
    }
  }
}
