##### General
NODE_ENV=development
PORT=3000
# Prefix that used to be added by nginx in production; the web app calls /auth/*
API_GLOBAL_PREFIX=auth
# Public URL of this API including the prefix (used for mock OAuth redirects)
API_PUBLIC_URL=http://localhost:3000/auth
# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:3001
APP_PROFILE_URL=http://localhost:3001/en/dashboard/profile

##### Database (matches docker-compose.yml in the repo root)
DB_HOST=localhost
DB_PORT=5432
DB_USER=willbe
DB_PASS=willbe
DB_NAME=willbe
# Print every SQL query to the console
DB_LOGGING=false

##### Redis (BullMQ queues)
REDIS_HOST=localhost
REDIS_PORT=6379

##### JWT
JWT_SECRET=change-me-local-dev-secret

##### LinkedIn / Sales Navigator data source
# mock    - offline generated dataset, no external accounts needed (default)
# unipile - real Unipile API (requires a Sales Navigator account and the UNIPILE_* keys below)
LINKEDIN_PROVIDER=mock
UNIPILE_API_KEY=
UNIPILE_API_URL=
# Where the browser lands after connecting LinkedIn
UNIPILE_LINKEDIN_AUTH_REDIRECT_URL=http://localhost:3001/en/dashboard/profile
UNIPILE_LINKEDIN_AUTH_NOTIFY_URL=

##### Email delivery
# mock      - emails are logged instead of sent and get simulated replies / meetings / bounces
# connected - send through the user's connected Gmail / Outlook account
EMAIL_DELIVERY=mock
DEMO_REPLY_DELAY_MINUTES=2

##### AI message generation
# LLM_PROVIDER: none (default, messages from templates, no cost) | openai-compatible | claude
# If the provider is misconfigured or a call fails, templates are used instead.
LLM_PROVIDER=none
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Ollama (local, free): ollama pull llama3.1
# LLM_PROVIDER=openai-compatible
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=llama3.1
# Groq (free tier, key at https://console.groq.com/keys):
# LLM_PROVIDER=openai-compatible
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=gsk_...
# LLM_MODEL=llama-3.3-70b-versatile
# OpenRouter (free models, key at https://openrouter.ai/keys):
# LLM_PROVIDER=openai-compatible
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=sk-or-...
# LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free
# OpenAI: LLM_PROVIDER=openai-compatible, LLM_BASE_URL empty, LLM_API_KEY=sk-..., LLM_MODEL=gpt-4o-mini
# Claude (paid):
# LLM_PROVIDER=claude
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5

##### SendGrid (invites / password reset)
SENDGRID_API_KEY=SG.placeholder
SENDGRID_FROM_EMAIL=no-reply@example.com
SENDGRID_RESET_PASSWORD_LINK=http://localhost:3001/en/reset-password
SENDGRID_INVITE_LINK=http://localhost:3001/en/sign-in

##### OAuth providers (placeholders are enough to boot; real values only for social login)
GOOGLE_CLIENT_ID=placeholder
GOOGLE_CLIENT_SECRET=placeholder
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/users-accounts/gmail/redirect
GOOGLE_AUTH_CALLBACK_URL=http://localhost:3000/auth/google/redirect
LINKEDIN_CLIENT_ID=placeholder
LINKEDIN_CLIENT_SECRET=placeholder
LINKEDIN_CALLBACK_URL=http://localhost:3000/auth/linkedin/redirect
MICROSOFT_CLIENT_ID=placeholder
MICROSOFT_CLIENT_SECRET=placeholder
MICROSOFT_CALLBACK_URL=http://localhost:3000/auth/users-accounts/outlook/redirect
AUTH_REDIRECT_BASE_URL=http://localhost:3001

##### Optional integrations
GOOGLE_TRANSLATE_API_KEY=
BETTER_CONTACT_API_KEY=
BETTER_CONTACT_RESULT_WEBHOOK=
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
HUBSPOT_REDIRECT_URI=
THE_COMPANIES_API_KEY=
